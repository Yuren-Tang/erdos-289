import Universal.Target.CompactResolution

import Mathlib.Algebra.Module.Submodule.Map
import Mathlib.CategoryTheory.Limits.Shapes.IsTerminal
import Mathlib.RingTheory.Finiteness.Finsupp

/-!
# Least absorber

For a compact stage `H` and a class `d` modulo `H`, the least absorber is
the inverse image of the cyclic image generated by `d` under the quotient
map.  Its compactness is the finite-generation extension argument for
`0 → H → H[d] → ⟨d⟩ → 0`.
-/

open CategoryTheory
open CategoryTheory.Limits
open QuotientAddGroup

namespace Erdos289

universe u

section

variable {A : Type u} [AddCommGroup A]

/-- The image of the free abelian group on one generator sent to `d`. -/
def cyclicImage (d : A) : AddSubgroup A :=
  (FreeAbelianGroup.lift (α := Unit) (β := A) fun _ ↦ d).range

theorem cyclicImage_eq_closure (d : A) :
    cyclicImage d = AddSubgroup.closure {d} := by
  apply le_antisymm
  · intro y hy
    change ∃ z, (FreeAbelianGroup.lift (α := Unit) fun _ ↦ d) z = y at hy
    rcases hy with ⟨z, rfl⟩
    induction z using FreeAbelianGroup.induction_on with
    | zero => exact (AddSubgroup.closure {d}).zero_mem
    | of x =>
        simpa [cyclicImage] using
          (AddSubgroup.subset_closure (Set.mem_singleton d))
    | neg x hx => simpa using (AddSubgroup.closure {d}).neg_mem hx
    | add x y hx hy => simpa using (AddSubgroup.closure {d}).add_mem hx hy
  · rw [AddSubgroup.closure_le]
    intro x hx
    rw [Set.mem_singleton_iff.mp hx]
    change ∃ z, (FreeAbelianGroup.lift (α := Unit) fun _ ↦ d) z = d
    exact ⟨FreeAbelianGroup.of (), by simp [cyclicImage]⟩

theorem cyclicImage_finitelyGenerated (d : A) : (cyclicImage d).FG := by
  rw [cyclicImage_eq_closure]
  exact ⟨{d}, by simp⟩

end

section

variable {Γ : Type u} [AddCommGroup Γ]
variable {t : Marking Γ}

/-- The underlying subgroup `H[d]`: the inverse image of the cyclic image
generated by `d` under `A_t → A_t/H`. -/
def leastAbsorberSubgroup (H : CompactStage t)
    (d : CenteredMarking t ⧸ H.1) : AddSubgroup (CenteredMarking t) :=
  (cyclicImage d).comap (QuotientAddGroup.mk' H.1)

private theorem leastAbsorber_map (H : CompactStage t)
    (d : CenteredMarking t ⧸ H.1) :
    (leastAbsorberSubgroup H d).map (QuotientAddGroup.mk' H.1) = cyclicImage d := by
  rw [leastAbsorberSubgroup, AddSubgroup.map_comap_eq]
  have hsurj : Function.Surjective (QuotientAddGroup.mk' H.1) :=
    QuotientAddGroup.mk'_surjective H.1
  rw [AddMonoidHom.range_eq_top.mpr hsurj, top_inf_eq]

private theorem leastAbsorber_inf_kernel (H : CompactStage t)
    (d : CenteredMarking t ⧸ H.1) :
    leastAbsorberSubgroup H d ⊓ (QuotientAddGroup.mk' H.1).ker = H.1 := by
  rw [QuotientAddGroup.ker_mk']
  apply le_antisymm
  · exact inf_le_right
  · refine le_inf ?_ le_rfl
    intro x hx
    change QuotientAddGroup.mk' H.1 x ∈ cyclicImage d
    have hz : QuotientAddGroup.mk' H.1 x = 0 :=
      (QuotientAddGroup.eq_zero_iff x).2 hx
    rw [hz]
    exact (cyclicImage d).zero_mem

private theorem leastAbsorber_finitelyGenerated (H : CompactStage t)
    (d : CenteredMarking t ⧸ H.1) : (leastAbsorberSubgroup H d).FG := by
  have hfg : (leastAbsorberSubgroup H d).toIntSubmodule.FG := by
    apply Submodule.fg_of_fg_map_of_fg_inf_ker
      (QuotientAddGroup.mk' H.1).toIntLinearMap
    · simpa [leastAbsorber_map H d] using
        (Submodule.fg_iff_addSubgroup_fg (cyclicImage d).toIntSubmodule).2
          (cyclicImage_finitelyGenerated d)
    · have hinter := congrArg AddSubgroup.toIntSubmodule
          (leastAbsorber_inf_kernel H d)
      change ((leastAbsorberSubgroup H d).toIntSubmodule ⊓
        (QuotientAddGroup.mk' H.1).ker.toIntSubmodule).FG
      rw [show (leastAbsorberSubgroup H d).toIntSubmodule ⊓
          (QuotientAddGroup.mk' H.1).ker.toIntSubmodule = H.1.toIntSubmodule by
        exact hinter]
      exact (Submodule.fg_iff_addSubgroup_fg H.1.toIntSubmodule).2
        ((compactSubgroup_iff_finitelyGenerated H.1).1 H.2)
  simpa using (Submodule.fg_iff_addSubgroup_fg
    (leastAbsorberSubgroup H d).toIntSubmodule).1 hfg

/-- The least compact stage above `H` which kills `d`. -/
def LeastAbsorber (H : CompactStage t)
    (d : CenteredMarking t ⧸ H.1) : CompactStage t :=
  ⟨leastAbsorberSubgroup H d,
    (compactSubgroup_iff_finitelyGenerated _).2
      (leastAbsorber_finitelyGenerated H d)⟩

theorem leastAbsorber_compact (H : CompactStage t)
    (d : CenteredMarking t ⧸ H.1) :
    IsCompactElement (LeastAbsorber H d).1 :=
  (LeastAbsorber H d).2

theorem leastAbsorber_contains (H : CompactStage t)
    (d : CenteredMarking t ⧸ H.1) : H ≤ LeastAbsorber H d := by
  intro x hx
  change QuotientAddGroup.mk' H.1 x ∈ cyclicImage d
  have hz : QuotientAddGroup.mk' H.1 x = 0 :=
    (QuotientAddGroup.eq_zero_iff x).2 hx
  rw [hz]
  exact (cyclicImage d).zero_mem

/-- The inclusion in the pullback sequence `0 → H → H[d]`. -/
def leastAbsorberKernelMap (H : CompactStage t)
    (d : CenteredMarking t ⧸ H.1) :
    H.1 →+ (LeastAbsorber H d).1 :=
  AddSubgroup.inclusion (leastAbsorber_contains H d)

/-- The surjection in the pullback sequence `H[d] → ⟨d⟩`. -/
def leastAbsorberCyclicMap (H : CompactStage t)
    (d : CenteredMarking t ⧸ H.1) :
    (LeastAbsorber H d).1 →+ cyclicImage d :=
  ((QuotientAddGroup.mk' H.1).domRestrict (LeastAbsorber H d).1).codRestrict
    (cyclicImage d) fun x ↦ x.2

/-- Exactness of the fixed pullback sequence
`0 → H → H[d] → ⟨d⟩ → 0`. -/
theorem leastAbsorber_exact (H : CompactStage t)
    (d : CenteredMarking t ⧸ H.1) :
    Function.Exact (leastAbsorberKernelMap H d) (leastAbsorberCyclicMap H d) := by
  rw [AddMonoidHom.exact_iff]
  ext x
  rw [AddMonoidHom.mem_ker]
  rw [AddMonoidHom.mem_range]
  dsimp [leastAbsorberCyclicMap, leastAbsorberKernelMap]
  constructor
  · intro hx
    have hxq : QuotientAddGroup.mk' H.1 x.1 = 0 := congrArg Subtype.val hx
    exact ⟨⟨x.1, (QuotientAddGroup.eq_zero_iff x.1).1 hxq⟩, Subtype.ext rfl⟩
  · rintro ⟨y, rfl⟩
    apply Subtype.ext
    exact (QuotientAddGroup.eq_zero_iff y.1).2 y.2

/-- The left-hand map in the pullback short exact sequence is injective. -/
theorem leastAbsorberKernelMap_injective (H : CompactStage t)
    (d : CenteredMarking t ⧸ H.1) :
    Function.Injective (leastAbsorberKernelMap H d) := by
  intro x y hxy
  apply Subtype.ext
  exact congrArg (fun z : (LeastAbsorber H d).1 ↦ z.1) hxy

/-- The right-hand map in the pullback short exact sequence is surjective. -/
theorem leastAbsorberCyclicMap_surjective (H : CompactStage t)
    (d : CenteredMarking t ⧸ H.1) :
    Function.Surjective (leastAbsorberCyclicMap H d) := by
  intro y
  have hy : y.1 ∈ (leastAbsorberSubgroup H d).map
      (QuotientAddGroup.mk' H.1) := by
    rw [leastAbsorber_map H d]
    exact y.2
  rcases hy with ⟨x, hx, hxy⟩
  exact ⟨⟨x, hx⟩, Subtype.ext hxy⟩

/-- The complete frozen short exact sequence
`0 → H → H[d] → ⟨d⟩ → 0`. -/
theorem leastAbsorber_shortExact (H : CompactStage t)
    (d : CenteredMarking t ⧸ H.1) :
    Function.Injective (leastAbsorberKernelMap H d) ∧
      Function.Exact (leastAbsorberKernelMap H d) (leastAbsorberCyclicMap H d) ∧
      Function.Surjective (leastAbsorberCyclicMap H d) :=
  ⟨leastAbsorberKernelMap_injective H d, leastAbsorber_exact H d,
    leastAbsorberCyclicMap_surjective H d⟩

theorem leastAbsorber_kills (H : CompactStage t)
    (d : CenteredMarking t ⧸ H.1) :
    compactResolutionTransition t (leastAbsorber_contains H d) d = 0 := by
  obtain ⟨x, rfl⟩ := QuotientAddGroup.mk'_surjective H.1 d
  apply (QuotientAddGroup.eq_zero_iff x).2
  change QuotientAddGroup.mk' H.1 x ∈ cyclicImage _
  change ∃ z, (FreeAbelianGroup.lift (α := Unit)
    fun _ ↦ QuotientAddGroup.mk' H.1 x) z = QuotientAddGroup.mk' H.1 x
  exact ⟨FreeAbelianGroup.of (), by simp only [FreeAbelianGroup.lift_apply_of]⟩

/-- A stage `G` above `H` kills the quotient class `d`. -/
def StageKills (H G : CompactStage t) (d : CenteredMarking t ⧸ H.1) : Prop :=
  ∃ h : H ≤ G, compactResolutionTransition t h d = 0

/-- The frozen universal characterization of the least absorber. -/
theorem leastAbsorber_le_iff (H G : CompactStage t)
    (d : CenteredMarking t ⧸ H.1) :
    LeastAbsorber H d ≤ G ↔ StageKills H G d := by
  constructor
  · intro h
    have hHG : H ≤ G := (leastAbsorber_contains H d).trans h
    refine ⟨hHG, ?_⟩
    obtain ⟨x, rfl⟩ := QuotientAddGroup.mk'_surjective H.1 d
    apply (QuotientAddGroup.eq_zero_iff x).2
    apply h
    change ∃ z, (FreeAbelianGroup.lift (α := Unit)
      fun _ ↦ QuotientAddGroup.mk' H.1 x) z = QuotientAddGroup.mk' H.1 x
    exact ⟨FreeAbelianGroup.of (), by simp only [FreeAbelianGroup.lift_apply_of]⟩
  · rintro ⟨hHG, hkill⟩ x hx
    change x ∈ G.1
    change QuotientAddGroup.mk' H.1 x ∈ cyclicImage d at hx
    change ∃ z, (FreeAbelianGroup.lift (α := Unit) fun _ ↦ d) z =
      QuotientAddGroup.mk' H.1 x at hx
    rcases hx with ⟨z, hz⟩
    have hcomp :
        (compactResolutionTransition t hHG).comp
            (FreeAbelianGroup.lift (α := Unit) fun _ ↦ d) =
          FreeAbelianGroup.lift (α := Unit) (fun _ ↦
            compactResolutionTransition t hHG d) := by
      apply FreeAbelianGroup.lift_ext
      intro a
      simp
    apply (QuotientAddGroup.eq_zero_iff x).1
    calc
      QuotientAddGroup.mk' G.1 x =
          compactResolutionTransition t hHG (QuotientAddGroup.mk' H.1 x) := rfl
      _ = compactResolutionTransition t hHG
          ((FreeAbelianGroup.lift (α := Unit) fun _ ↦ d) z) := congrArg _ hz.symm
      _ = (FreeAbelianGroup.lift (α := Unit) fun _ ↦
          compactResolutionTransition t hHG d) z := by
            exact DFunLike.congr_fun hcomp z
      _ = 0 := by
        rw [hkill]
        have hlift : (FreeAbelianGroup.lift (α := Unit)
            (fun _ ↦ (0 : CenteredMarking t ⧸ G.1))) = 0 := by
          apply FreeAbelianGroup.lift_ext
          intro a
          simp
        rw [hlift]
        rfl

/-- Compact stages above `H` in which `d` dies. -/
abbrev KillingStage (H : CompactStage t)
    (d : CenteredMarking t ⧸ H.1) :=
  {G : CompactStage t // StageKills H G d}

/-- `LeastAbsorber H d`, equipped with its killing-stage property. -/
def leastAbsorberKillingStage (H : CompactStage t)
    (d : CenteredMarking t ⧸ H.1) : KillingStage H d :=
  ⟨LeastAbsorber H d, ⟨leastAbsorber_contains H d, leastAbsorber_kills H d⟩⟩

/-- The least absorber is initial in the preorder of killing stages. -/
def leastAbsorber_isInitial (H : CompactStage t)
    (d : CenteredMarking t ⧸ H.1) :
    IsInitial (leastAbsorberKillingStage H d) :=
  IsInitial.ofUniqueHom
    (fun G ↦ homOfLE ((leastAbsorber_le_iff H G.1 d).2 G.2))
    (fun _ _ ↦ by subsingleton)

end


end Erdos289
