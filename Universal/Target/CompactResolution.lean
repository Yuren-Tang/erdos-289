import Universal.Target.Centering

import Mathlib.Algebra.Category.Grp.Zero
import Mathlib.CategoryTheory.Filtered.Basic
import Mathlib.CategoryTheory.Limits.Shapes.ZeroObjects
import Mathlib.CategoryTheory.Whiskering
import Mathlib.Order.Bounds.OrderIso
import Mathlib.RingTheory.Finiteness.Basic

/-!
# Compact quotient resolution

For an arbitrary marking `t`, the stages are precisely the compact elements
of the subgroup lattice of its centered target.  The stage indexed by `H` is
the quotient `CenteredMarking t ⧸ H`, with transition maps induced by subgroup
inclusion.
-/

open CategoryTheory
open CategoryTheory.Limits
open QuotientAddGroup
open scoped ZeroObject

namespace Erdos289

universe u

private theorem isCompactElement_of_orderIso
    {α β : Type*} [PartialOrder α] [PartialOrder β]
    (e : α ≃o β) {a : α} (ha : IsCompactElement (e a)) :
    IsCompactElement a := by
  intro s b hs hdirected hlub hab
  have himage : (e '' s).Nonempty := hs.image e
  have hdirectedImage : DirectedOn (· ≤ ·) (e '' s) := by
    rintro _ ⟨x, hx, rfl⟩ _ ⟨y, hy, rfl⟩
    obtain ⟨z, hz, hxz, hyz⟩ := hdirected x hx y hy
    exact ⟨e z, ⟨z, hz, rfl⟩, e.monotone hxz, e.monotone hyz⟩
  obtain ⟨_, ⟨x, hx, rfl⟩, hax⟩ :=
    ha (e '' s) (e b) himage hdirectedImage
      ((OrderIso.isLUB_image' e).2 hlub) (e.monotone hab)
  exact ⟨x, hx, e.le_iff_le.mp hax⟩

private theorem isCompactElement_orderIso_iff
    {α β : Type*} [PartialOrder α] [PartialOrder β]
    (e : α ≃o β) (a : α) :
    IsCompactElement (e a) ↔ IsCompactElement a := by
  constructor
  · exact isCompactElement_of_orderIso e
  · intro ha
    apply isCompactElement_of_orderIso e.symm
    simpa using ha

/-- Compactness in the algebraic subgroup lattice is exactly finite
generation. -/
theorem compactSubgroup_iff_finitelyGenerated
    {A : Type u} [AddCommGroup A] (H : AddSubgroup A) :
    IsCompactElement H ↔ H.FG := by
  rw [← (isCompactElement_orderIso_iff AddSubgroup.toIntSubmodule H),
    ← Submodule.fg_iff_compact, Submodule.fg_iff_addSubgroup_fg,
    AddSubgroup.toIntSubmodule_toAddSubgroup]

/-- The compact subgroup stages of the centered quotient of an arbitrary
marking. -/
abbrev CompactStage {Γ : Type u} [AddCommGroup Γ] (t : Marking Γ) :=
  {H : AddSubgroup (CenteredMarking t) //
    IsCompactElement H}

namespace CompactStage

variable {Γ : Type u} [AddCommGroup Γ] {t : Marking Γ}

/-- The bottom compact stage. -/
def bot : CompactStage t :=
  ⟨⊥, (compactSubgroup_iff_finitelyGenerated _).2 AddSubgroup.FG.bot⟩

/-- The finite join of two compact stages. -/
def finiteJoin (H K : CompactStage t) : CompactStage t :=
  ⟨H.1 ⊔ K.1, (compactSubgroup_iff_finitelyGenerated _).2
    (((compactSubgroup_iff_finitelyGenerated H.1).1 H.2).sup
      ((compactSubgroup_iff_finitelyGenerated K.1).1 K.2))⟩

/-- Finite joins provide the filteredness of compact stages. -/
theorem finiteJoin_upperBounds (H K : CompactStage t) :
    H ≤ finiteJoin H K ∧ K ≤ finiteJoin H K :=
  ⟨(show H.1 ≤ H.1 ⊔ K.1 from le_sup_left),
    (show K.1 ≤ H.1 ⊔ K.1 from le_sup_right)⟩

instance : IsFiltered (CompactStage t) where
  cocone_objs H K :=
    ⟨finiteJoin H K,
      homOfLE (show H.1 ≤ H.1 ⊔ K.1 from le_sup_left),
      homOfLE (show K.1 ≤ H.1 ⊔ K.1 from le_sup_right), trivial⟩
  cocone_maps _ _ f g := ⟨_, 𝟙 _, by subsingleton⟩
  nonempty := ⟨bot⟩

end CompactStage

section Resolution

variable {Γ : Type u} [AddCommGroup Γ]
variable (t : Marking Γ)

/-- The quotient transition associated to an inclusion of compact stages. -/
def compactResolutionTransition {H K : CompactStage t} (h : H ≤ K) :
    (CenteredMarking t ⧸ H.1) →+ (CenteredMarking t ⧸ K.1) :=
  QuotientAddGroup.map H.1 K.1 (AddMonoidHom.id _) h

/-- The compact quotient resolution `H ↦ A_t / H`. -/
def compactResolution : CompactStage t ⥤ AddCommGrpCat.{u} where
  obj H := AddCommGrpCat.of (CenteredMarking t ⧸ H.1)
  map f := AddCommGrpCat.ofHom (compactResolutionTransition t (leOfHom f))
  map_id H := by
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    obtain ⟨a, rfl⟩ := QuotientAddGroup.mk'_surjective H.1 x
    rfl
  map_comp f g := by
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    obtain ⟨a, rfl⟩ := QuotientAddGroup.mk'_surjective _ x
    rfl

@[simp]
theorem compactResolution_map_mk {H K : CompactStage t} (h : H ⟶ K)
    (x : CenteredMarking t) :
    (compactResolution t).map h (QuotientAddGroup.mk' H.1 x) =
      QuotientAddGroup.mk' K.1 x :=
  rfl

/-- The centered observations `Γ → A_t/H`, natural in the compact stage. -/
def compactResolutionObservation :
    (Functor.const (CompactStage t)).obj (AddCommGrpCat.of Γ) ⟶
      compactResolution t where
  app H := AddCommGrpCat.ofHom
    ((QuotientAddGroup.mk' H.1).comp (markingQuotient t))
  naturality H K f := by
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    rfl

/-- Every quotient class dies after joining the current stage with the cyclic
subgroup generated by a representative. -/
theorem compactResolution_eventually_zero (H : CompactStage t)
    (x : (compactResolution t).obj H) :
    ∃ (K : CompactStage t) (f : H ⟶ K),
      (compactResolution t).map f x = 0 := by
  obtain ⟨a, rfl⟩ := QuotientAddGroup.mk'_surjective H.1 x
  have hcyclic : (AddSubgroup.closure ({a} : Set (CenteredMarking t))).FG :=
    ⟨{a}, by simp⟩
  let K : CompactStage t :=
    ⟨H.1 ⊔ AddSubgroup.closure {a},
      (compactSubgroup_iff_finitelyGenerated _).2
        (((compactSubgroup_iff_finitelyGenerated H.1).1 H.2).sup hcyclic)⟩
  let f : H ⟶ K := homOfLE (show H.1 ≤ K.1 from le_sup_left)
  refine ⟨K, f, ?_⟩
  change QuotientAddGroup.mk' K.1 a = 0
  apply (QuotientAddGroup.eq_zero_iff a).2
  exact (show AddSubgroup.closure {a} ≤ K.1 from le_sup_right)
    (AddSubgroup.subset_closure (Set.mem_singleton a))

/-- The canonical cocone from the quotient resolution to the zero abelian
group. -/
noncomputable def compactResolutionZeroCocone : Cocone (compactResolution t) where
  pt := 0
  ι := {
    app := fun _ ↦ 0
    naturality := fun _ _ _ ↦ by
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro x
      rfl }

private theorem compactResolution_cocone_leg_zero
    (s : Cocone (compactResolution t)) (H : CompactStage t) :
    s.ι.app H = 0 := by
  apply AddCommGrpCat.hom_ext
  apply AddMonoidHom.ext
  intro x
  obtain ⟨K, f, hx⟩ := compactResolution_eventually_zero t H x
  have hw := ConcreteCategory.congr_hom (s.w f)
  change s.ι.app H x = 0
  rw [← hw x]
  change s.ι.app K ((compactResolution t).map f x) = 0
  rw [hx, map_zero]

/-- The zero cocone is a colimit cocone: the filtered colimit of the compact
quotient resolution is zero. -/
noncomputable def compactResolution_colimit_zero :
    IsColimit (compactResolutionZeroCocone t) where
  desc _ := 0
  fac s H := by
    rw [compactResolution_cocone_leg_zero t s H]
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    rfl
  uniq s m _ := by
    change m = (0 : (0 : AddCommGrpCat) ⟶ s.pt)
    exact (isZero_zero AddCommGrpCat).eq_of_src _ _

end Resolution

section MarkingMap

variable {Γ : Type u} [AddCommGroup Γ]
variable {t t' t'' : Marking Γ}

private theorem markingCenteringMap_id_apply (x : CenteredMarking t) :
    markingCenteringMap (𝟙 t) x = x := by
  obtain ⟨a, rfl⟩ :=
    QuotientAddGroup.mk'_surjective (markingFreeMap t).range x
  rfl

private theorem markingCenteringMap_comp_apply (h : t ⟶ t') (k : t' ⟶ t'')
    (x : CenteredMarking t) :
    markingCenteringMap (h ≫ k) x =
      markingCenteringMap k (markingCenteringMap h x) := by
  obtain ⟨a, rfl⟩ :=
    QuotientAddGroup.mk'_surjective (markingFreeMap t).range x
  rfl

/-- Image of compact subgroups under the centering comparison, as a functor
between compact-stage categories. -/
def compactStage_mapMarking (h : t ⟶ t') : CompactStage t ⥤ CompactStage t' where
  obj H :=
    ⟨H.1.map (markingCenteringMap h),
      (compactSubgroup_iff_finitelyGenerated _).2
        ((Submodule.fg_iff_addSubgroup_fg _).1 (by
          simpa using ((Submodule.fg_iff_addSubgroup_fg H.1.toIntSubmodule).2
            ((compactSubgroup_iff_finitelyGenerated H.1).1 H.2)).map
              (markingCenteringMap h).toIntLinearMap))⟩
  map f := homOfLE (AddSubgroup.map_mono (leOfHom f))

/-- Identity coherence for the image construction on compact stages. -/
theorem compactStage_mapMarking_id_obj (H : CompactStage t) :
    ((compactStage_mapMarking (𝟙 t)).obj H).1 = H.1 := by
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    change y ∈ H.1 at hy
    rw [markingCenteringMap_id_apply]
    exact hy
  · intro hx
    exact ⟨x, hx, markingCenteringMap_id_apply x⟩

/-- Composition coherence for the image construction on compact stages. -/
theorem compactStage_mapMarking_comp_obj (h : t ⟶ t') (k : t' ⟶ t'')
    (H : CompactStage t) :
    ((compactStage_mapMarking (h ≫ k)).obj H).1 =
      ((compactStage_mapMarking h ⋙ compactStage_mapMarking k).obj H).1 := by
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    exact ⟨markingCenteringMap h y, ⟨y, hy, rfl⟩,
      (markingCenteringMap_comp_apply h k y).symm⟩
  · rintro ⟨_, ⟨y, hy, rfl⟩, rfl⟩
    exact ⟨y, hy, markingCenteringMap_comp_apply h k y⟩

/-- The compact-stage image functor preserves identity, canonically. -/
def compactStage_mapMarking_idIso :
    compactStage_mapMarking (𝟙 t) ≅ 𝟭 (CompactStage t) :=
  NatIso.ofComponents
    (fun H ↦ eqToIso (Subtype.ext (compactStage_mapMarking_id_obj H)))

/-- The compact-stage image functor preserves composition, canonically. -/
def compactStage_mapMarking_compIso (h : t ⟶ t') (k : t' ⟶ t'') :
    compactStage_mapMarking (h ≫ k) ≅
      compactStage_mapMarking h ⋙ compactStage_mapMarking k :=
  NatIso.ofComponents
    (fun H ↦ eqToIso (Subtype.ext (compactStage_mapMarking_comp_obj h k H)))

/-- The natural comparison of compact quotient resolutions induced by a
morphism of markings. -/
def compactResolution_mapMarking (h : t ⟶ t') :
    compactResolution t ⟶
      compactStage_mapMarking h ⋙ compactResolution t' where
  app H := AddCommGrpCat.ofHom
    (QuotientAddGroup.map H.1
      ((compactStage_mapMarking h).obj H).1
      (markingCenteringMap h)
      (AddSubgroup.le_comap_map (markingCenteringMap h) H.1))
  naturality H K f := by
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    obtain ⟨a, rfl⟩ := QuotientAddGroup.mk'_surjective H.1 x
    rfl

/-- Identity coherence of the quotient-resolution comparison. -/
theorem compactResolution_mapMarking_id :
    compactResolution_mapMarking (t := t) (𝟙 t) ≫
        Functor.whiskerRight (compactStage_mapMarking_idIso (t := t)).hom
          (compactResolution t) =
      𝟙 (compactResolution t) := by
  apply NatTrans.ext
  funext H
  apply AddCommGrpCat.hom_ext
  apply AddMonoidHom.ext
  intro x
  obtain ⟨a, rfl⟩ := QuotientAddGroup.mk'_surjective H.1 x
  simp only [Functor.whiskerRight, compactStage_mapMarking_idIso,
    compactResolution_mapMarking, compactResolution,
    compactResolutionTransition, NatTrans.comp_app,
    Functor.comp_obj, Functor.id_obj,
    NatIso.ofComponents_hom_app]
  change QuotientAddGroup.mk' H.1 (markingCenteringMap (𝟙 t) a) =
    QuotientAddGroup.mk' H.1 a
  rw [markingCenteringMap_id_apply]

/-- Composition coherence of the quotient-resolution comparison. -/
theorem compactResolution_mapMarking_comp (h : t ⟶ t') (k : t' ⟶ t'') :
    compactResolution_mapMarking (h ≫ k) ≫
        Functor.whiskerRight (compactStage_mapMarking_compIso h k).hom
          (compactResolution t'') =
      compactResolution_mapMarking h ≫
        Functor.whiskerLeft (compactStage_mapMarking h)
          (compactResolution_mapMarking k) := by
  apply NatTrans.ext
  funext H
  apply AddCommGrpCat.hom_ext
  apply AddMonoidHom.ext
  intro x
  obtain ⟨a, rfl⟩ := QuotientAddGroup.mk'_surjective H.1 x
  simp only [Functor.whiskerRight, Functor.whiskerLeft,
    compactStage_mapMarking_compIso, compactResolution_mapMarking,
    compactResolution, compactResolutionTransition,
    NatTrans.comp_app, Functor.comp_obj,
    NatIso.ofComponents_hom_app]
  change QuotientAddGroup.mk'
      ((compactStage_mapMarking k).obj ((compactStage_mapMarking h).obj H)).1
        (markingCenteringMap (h ≫ k) a) =
    QuotientAddGroup.mk'
      ((compactStage_mapMarking k).obj ((compactStage_mapMarking h).obj H)).1
        (markingCenteringMap k (markingCenteringMap h a))
  rw [markingCenteringMap_comp_apply]

/-- The frozen U4.3 functoriality package: compact-stage images and their
quotient-resolution comparisons preserve identity and composition. -/
theorem compactResolution_functorial :
    (compactResolution_mapMarking (t := t) (𝟙 t) ≫
        Functor.whiskerRight (compactStage_mapMarking_idIso (t := t)).hom
          (compactResolution t) =
      𝟙 (compactResolution t)) ∧
    (∀ {t' t'' : Marking Γ} (h : t ⟶ t') (k : t' ⟶ t''),
      compactResolution_mapMarking (h ≫ k) ≫
          Functor.whiskerRight (compactStage_mapMarking_compIso h k).hom
            (compactResolution t'') =
        compactResolution_mapMarking h ≫
          Functor.whiskerLeft (compactStage_mapMarking h)
            (compactResolution_mapMarking k)) :=
  ⟨compactResolution_mapMarking_id, fun h k ↦
    compactResolution_mapMarking_comp h k⟩

end MarkingMap

end Erdos289
